{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Secure Note Vault",
  "version": "0.1.0",
  "identifier": "com.securenote.vault",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "withGlobalTauri": false, "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; frame-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'" }, "windows": [{ "title": "Secure Note Vault", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 620 }], "trayIcon": null },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "Apple Development",
      "files": {
        "embedded.provisionprofile": "./embedded.provisionprofile"
      }
    }
  }
}
